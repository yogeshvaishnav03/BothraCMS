{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/prepare-db.js && next build",
  "rewrites": [
    {
      "source": "/.well-known/assetlinks.json",
      "destination": "/api/assetlinks"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/whatsapp",
      "schedule": "30 4 * * *"
    }
  ]
}
