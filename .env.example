# Environment Configuration Template for Build Track Pro
# Copy this file to .env and configure local variables

# Database (PostgreSQL for cloud deployment e.g. Neon, Supabase, Vercel Postgres)
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session Security (32-character random string)
SESSION_SECRET="build_track_pro_super_secure_session_secret_2026_key"

# Application Environment
NODE_ENV="development"
PORT=3000

# Regional Defaults
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"
