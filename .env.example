# ==============================================================================
# BothraCMS (BuildTrack Pro) — Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL Required for Production)
# ------------------------------------------------------------------------------
# Connection pooling URL (e.g., Supabase transaction pooler, Neon pooled connection)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require&pgbouncer=true"

# Direct URL for schema migrations and administrative operations (optional but recommended)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?sslmode=require"

# ------------------------------------------------------------------------------
# 2. SESSION & CRYPTOGRAPHIC SECURITY
# ------------------------------------------------------------------------------
# Mandatory cryptographically random secret of at least 32 characters.
# Generate via: openssl rand -base64 48
SESSION_SECRET="replace_with_a_secure_random_production_secret_32chars_minimum"

# Demo data seeding (Super Admin "Add Demo Data", Day Book demo, build-time seed scripts)
# is disabled in production unless this is set to "true" (use only on a demo/staging tenant).
ALLOW_DEMO_SEED="false"

# Application runtime environment (production | development | test)
NODE_ENV="production"
PORT=3000

# ------------------------------------------------------------------------------
# 3. CLOUD STORAGE (AWS S3 or Cloudflare R2)
# ------------------------------------------------------------------------------
# Required for serverless deployments (Vercel, AWS) to persist invoices & site photos.
# If omitted in local development, falls back safely to storage/uploads/private
S3_BUCKET="bothracms-production-documents"
AWS_ACCESS_KEY_ID="your_aws_or_r2_access_key_id"
AWS_SECRET_ACCESS_KEY="your_aws_or_r2_secret_access_key"
AWS_REGION="ap-south-1"

# For Cloudflare R2, specify the account endpoint:
# S3_ENDPOINT="https://[ACCOUNT_ID].r2.cloudflarestorage.com"

# ------------------------------------------------------------------------------
# 4. NOTIFICATIONS & EXTERNAL ALERTS (Optional)
# ------------------------------------------------------------------------------
# In-app notifications are natively stored and reactive. Configure third-party providers if needed:
# WHATSAPP_API_KEY=""
# WHATSAPP_PHONE_NUMBER_ID=""
# SMS_GATEWAY_URL=""
# SMS_API_TOKEN=""

# ------------------------------------------------------------------------------
# 5. REAL-TIME SYNCHRONIZATION (Optional)
# ------------------------------------------------------------------------------
# If omitted, application uses robust multi-tab broadcast channels and polling fallback.
# PUSHER_APP_ID=""
# PUSHER_KEY=""
# PUSHER_SECRET=""
# PUSHER_CLUSTER="ap2"

# ------------------------------------------------------------------------------
# 6. LOCALIZATION & REGIONAL DEFAULTS
# ------------------------------------------------------------------------------
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"
