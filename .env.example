# Environment Configuration Template for Build Track Pro
# Copy this file to .env and configure local variables

# Database (SQLite for zero-dependency local development; PostgreSQL for production)
DATABASE_URL="file:./dev.db"

# Session Security (32-character random string)
SESSION_SECRET="build_track_pro_super_secure_session_secret_2026_key"

# Application Environment
NODE_ENV="development"
PORT=3000

# Regional Defaults
DEFAULT_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"
