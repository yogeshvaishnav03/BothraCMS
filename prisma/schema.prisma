datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  currency     String   @default("INR")
  timezone     String   @default("Asia/Kolkata")
  settingsJson String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  sites              Site[]
  projects           Project[]
  materials          Material[]
  materialCategories MaterialCategory[]
  parties            Party[]
  workforceMembers   WorkforceMember[]
  auditEvents        AuditEvent[]
  tasks              Task[]
  bills              Bill[]
  payments           Payment[]
  stores             Store[]
  stockMovements     StockMovement[]
  attendanceSessions AttendanceSession[]
  dailyReports       DailySiteReport[]
  purchaseOrders     PurchaseOrder[]
  conversations      Conversation[]
  attachments        Attachment[]
  documentFolders    DocumentFolder[]
  taskComments       TaskComment[]
  projectAssignments ProjectAssignment[]
  notifications      Notification[]
  folderPermissions  FolderPermission[]
  measurementBookEntries MeasurementBookEntry[]
  workforceHeadcounts     WorkforceHeadcount[]
}

model User {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  email          String
  passwordHash   String
  role           String    @default("SITE_SUPERVISOR") // SUPER_ADMIN, ORG_ADMIN, PROJECT_MANAGER, SITE_SUPERVISOR, ACCOUNTANT, STOREKEEPER, HR_VIEWER, AUDITOR
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization                Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managedProjects             Project[]             @relation("ProjectManager")
  assignedTasks               Task[]                @relation("TaskAssignee")
  createdTasks                Task[]                @relation("TaskCreator")
  taskHistories               TaskStatusHistory[]
  createdReports              DailySiteReport[]
  createdMovements            StockMovement[]
  createdBills                Bill[]
  createdPayments             Payment[]
  createdAttendance           AttendanceSession[]   @relation("AttendanceCreator")
  correctedAttendance         AttendanceSession[]   @relation("AttendanceCorrector")
  createdOrders               PurchaseOrder[]       @relation("OrderCreator")
  createdConversations        Conversation[]        @relation("ConversationCreator")
  conversationParticipants    ConversationParticipant[]
  sentMessages                ChatMessage[]
  auditEvents                 AuditEvent[]
  completedTasks              Task[]                @relation("TaskCompleter")
  verifiedTasks               Task[]                @relation("TaskVerifier")
  taskComments                TaskComment[]
  uploadedAttachments         Attachment[]
  projectAssignments          ProjectAssignment[]
  assignedProjectAssignments  ProjectAssignment[]   @relation("ProjectAssignmentAssigner")
  notifications               Notification[]
  folderPermissions           FolderPermission[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Site {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String
  latitude       Float?
  longitude      Float?
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects           Project[]
  stores             Store[]
  workforceMembers   WorkforceMember[]
  attendanceSessions AttendanceSession[]
  purchaseOrders     PurchaseOrder[]
  workforceHeadcounts WorkforceHeadcount[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Project {
  id             String    @id @default(uuid())
  organizationId String
  siteId         String
  code           String
  name           String
  managerUserId  String?
  status         String    @default("IN_PROGRESS") // PLANNING, IN_PROGRESS, ON_HOLD, COMPLETED, ARCHIVED
  startDate      DateTime?
  endDate        DateTime?
  budgetAmount   Float     @default(0) // currency amount (e.g. INR rupees)
  notes          String?
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site               Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  manager            User?               @relation("ProjectManager", fields: [managerUserId], references: [id])
  tasks              Task[]
  dailyReports       DailySiteReport[]
  stockMovements     StockMovement[]
  bills              Bill[]
  payments           Payment[]
  attendanceSessions AttendanceSession[]
  purchaseOrders     PurchaseOrder[]
  attachments        Attachment[]
  documentFolders    DocumentFolder[]
  assignments        ProjectAssignment[]
  measurementBookEntries MeasurementBookEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, siteId])
}

model Task {
  id                  String    @id @default(uuid())
  organizationId      String
  projectId           String
  title               String
  description         String?
  priority            String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status              String    @default("TODO") // TODO, IN_PROGRESS, BLOCKED, COMPLETED, VERIFIED, ARCHIVED
  assigneeUserId      String?
  dueAt               DateTime?
  completedAt         DateTime?
  completedById       String?
  verifiedAt          DateTime?
  verifiedById        String?
  taskType            String?   @default("STANDARD") // STANDARD, PERSONAL, REQUEST_OWNER, REQUEST_MANAGER, REQUEST_ARCHITECT
  reminderAt          DateTime?
  reminderDeliveredAt DateTime?
  isArchived          Boolean   @default(false)
  archivedAt          DateTime?
  archivedById        String?
  archiveReason       String?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?               @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  creator        User                @relation("TaskCreator", fields: [createdBy], references: [id])
  completedBy    User?               @relation("TaskCompleter", fields: [completedById], references: [id])
  verifiedBy     User?               @relation("TaskVerifier", fields: [verifiedById], references: [id])
  statusHistory  TaskStatusHistory[]
  comments       TaskComment[]
  attachments    Attachment[]
  stockMovements StockMovement[]

  @@index([organizationId, projectId])
  @@index([status])
}

model TaskStatusHistory {
  id         String   @id @default(uuid())
  taskId     String
  oldStatus  String
  newStatus  String
  changedBy  String
  note       String?
  createdAt  DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [changedBy], references: [id])

  @@index([taskId])
}

model DailySiteReport {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  reportDate     String   // YYYY-MM-DD
  progress       String
  blockers       String?
  safetyNotes    String?
  createdBy      String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator        User         @relation(fields: [createdBy], references: [id])

  @@index([organizationId, projectId, reportDate])
}

model MaterialCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  materials      Material[]

  @@unique([organizationId, name])
}

model Material {
  id             String    @id @default(uuid())
  organizationId String
  categoryId     String?
  sku            String
  name           String
  unitCode       String   // BAG, KG, TONNE, LITRE, METER, PIECE, BOX
  minStockQty    Float    @default(0)
  reorderQty     Float    @default(0)
  active         Boolean  @default(true)
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       MaterialCategory? @relation(fields: [categoryId], references: [id])
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  billLines      BillLine[]
  purchaseOrders PurchaseOrder[]
  attachments    Attachment[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model Store {
  id             String    @id @default(uuid())
  organizationId String
  siteId         String
  name           String
  status         String    @default("ACTIVE") // ACTIVE, ARCHIVED
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId, siteId])
}

model StockBalance {
  id             String   @id @default(uuid())
  materialId     String
  storeId        String
  quantityOnHand Float    @default(0)
  updatedAt      DateTime @updatedAt

  material       Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([materialId, storeId])
  @@index([storeId])
}

model StockMovement {
  id             String    @id @default(uuid())
  organizationId String
  materialId     String
  storeId        String
  movementType   String    // RECEIPT, ISSUE, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT, OPENING
  quantityDelta  Float     // positive for in, negative for out
  unitCode       String
  unitRate       Float?    // rate per unit (paise/currency)
  movementAt     DateTime  @default(now())
  vendorPartyId  String?
  projectId      String?
  taskId         String?
  referenceDoc   String?   // Challan #, PO #, Transfer Voucher #
  reversalOfId   String?
  notes          String?
  isArchived     Boolean   @default(false)
  createdBy      String
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  material       Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vendor         Party?       @relation(fields: [vendorPartyId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])
  task           Task?        @relation(fields: [taskId], references: [id])
  creator        User         @relation(fields: [createdBy], references: [id])
  attachments    Attachment[]

  @@index([organizationId, materialId, storeId])
  @@index([movementAt])
}

model Party {
  id            String    @id @default(uuid())
  organizationId String
  partyType     String   // VENDOR, CONTRACTOR, BOTH
  name          String
  phone         String?
  email         String?
  address       String?
  taxIdentifier String?  // GSTIN / PAN
  active        Boolean  @default(true)
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?
  notes         String?
  contractValue Float?   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  bills          Bill[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  measurementBookEntries MeasurementBookEntry[]

  @@index([organizationId, partyType])
}

model Bill {
  id             String    @id @default(uuid())
  organizationId String
  partyId        String
  projectId      String?
  billNumber     String
  billDate       DateTime
  dueDate        DateTime?
  totalAmount    Float     // minor units / currency
  status         String    @default("POSTED") // DRAFT, POSTED, VOIDED, ARCHIVED
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  notes          String?
  createdBy      String
  postedAt       DateTime? @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party          Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id])
  creator        User         @relation(fields: [createdBy], references: [id])
  lines          BillLine[]
  allocations    PaymentAllocation[]
  measurements   MeasurementBookEntry[] @relation("MeasurementToBill")

  @@unique([organizationId, partyId, billNumber])
  @@index([organizationId, partyId])
  @@index([status])
}

model BillLine {
  id          String   @id @default(uuid())
  billId      String
  description String
  materialId  String?
  quantity    Float?
  unitRate    Float?   // currency
  lineTotal   Float    // currency

  bill        Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  material    Material? @relation(fields: [materialId], references: [id])

  @@index([billId])
}

model Payment {
  id              String    @id @default(uuid())
  organizationId  String
  partyId         String?
  recipientType   String?   @default("VENDOR") // VENDOR, CONTRACTOR, EMPLOYEE
  recipientName   String?
  payingAccount   String?   // Account from which to pay (e.g., "HDFC Bank Operating A/C", "ICICI Bank", "Petty Cash")
  approvalQuery   String?   // Reason or query submitted to Super Admin for approval
  approvedBy      String?   // Super Admin who confirmed or rejected
  approvedAt      DateTime?
  rejectionReason String?   // Reason if rejected
  projectId       String?
  paymentDate     DateTime
  amount          Float     // minor units / currency
  currency        String    @default("INR")
  method          String    // BANK_TRANSFER, UPI, CASH, CHEQUE, NEFT_RTGS
  referenceNumber String
  status          String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, POSTED, REJECTED, REVERSED
  idempotencyKey  String
  reversedAt      DateTime?
  reversalReason  String?
  isArchived      Boolean   @default(false)
  archivedAt      DateTime?
  archivedById    String?
  archiveReason   String?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party           Party?       @relation(fields: [partyId], references: [id], onDelete: Cascade)
  project         Project?     @relation(fields: [projectId], references: [id])
  creator         User         @relation(fields: [createdBy], references: [id])
  allocations     PaymentAllocation[]
  attachments     Attachment[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, partyId])
  @@index([paymentDate])
}

model PaymentAllocation {
  id         String    @id @default(uuid())
  paymentId  String
  billId     String
  amount     Float     // minor units / currency
  reversedAt DateTime?
  createdAt  DateTime  @default(now())

  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill       Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([billId])
}

model WorkforceMember {
  id             String    @id @default(uuid())
  organizationId String
  employeeCode   String
  name           String
  workerType     String   // MASON, CARPENTER, ELECTRICIAN, PLUMBER, HELPER, FOREMAN, SITE_ENGINEER
  phone          String?
  defaultSiteId  String?
  dailyWageRate  Float?   // currency
  active         Boolean  @default(true)
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultSite        Site?               @relation(fields: [defaultSiteId], references: [id])
  attendanceSessions AttendanceSession[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
}

model AttendanceSession {
  id                String    @id @default(uuid())
  organizationId    String
  workforceMemberId String
  siteId            String
  projectId         String?
  workDate          String    // YYYY-MM-DD
  checkInAt         DateTime
  checkInLat        Float?
  checkInLng        Float?
  checkInAccuracyM  Float?
  checkOutAt        DateTime?
  checkOutLat       Float?
  checkOutLng       Float?
  checkOutAccuracyM Float?
  status            String    @default("PRESENT") // PRESENT, HALF_DAY, OVERTIME, CORRECTED, ABSENT
  notes             String?
  correctedBy       String?
  correctionReason  String?
  isArchived        Boolean   @default(false)
  archivedAt        DateTime?
  archivedById      String?
  archiveReason     String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workforceMember   WorkforceMember @relation(fields: [workforceMemberId], references: [id], onDelete: Cascade)
  site              Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  project           Project?        @relation(fields: [projectId], references: [id])
  creator           User            @relation("AttendanceCreator", fields: [createdBy], references: [id])
  corrector         User?           @relation("AttendanceCorrector", fields: [correctedBy], references: [id])
  attachments       Attachment[]

  @@unique([organizationId, workforceMemberId, siteId, workDate])
  @@index([organizationId, siteId, workDate])
}

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  actorUserId    String
  action         String   // PAYMENT_POSTED, PAYMENT_REVERSED, STOCK_ADJUSTMENT, ATTENDANCE_CORRECTED, ROLE_CHANGED, etc.
  entityType     String
  entityId       String
  beforeJson     String?
  afterJson      String?
  reason         String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([createdAt])
}

model RateLimitRecord {
  key       String   @id
  points    Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model IdempotencyRecord {
  id               String   @id @default(uuid())
  organizationId   String
  key              String
  operation        String
  responseCode     Int
  responseBodyJson String
  createdAt        DateTime @default(now())

  @@unique([organizationId, key])
  @@index([organizationId, key])
}

model PurchaseOrder {
  id                   String    @id @default(uuid())
  organizationId       String
  orderNumber          String
  materialId           String
  vendorPartyId        String
  storeId              String?
  siteId               String?
  quantity             Float
  unitCode             String
  unitRate             Float?
  totalAmount          Float?
  status               String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, PLACED, CONFIRMED, DELIVERED, CANCELLED
  approvalQuery        String?   // Query or justification submitted to Super Admin for approval
  approvedBy           String?   // User / Super Admin who confirmed or rejected
  approvedAt           DateTime?
  rejectionReason      String?   // Reason provided if rejected
  expectedDeliveryDate DateTime?
  notes                String?
  notificationMethod   String?   @default("WHATSAPP_AND_EMAIL")
  notificationSent     Boolean   @default(false)
  notificationSentAt   DateTime?
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  material             Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  vendor               Party        @relation(fields: [vendorPartyId], references: [id], onDelete: Cascade)
  store                Store?       @relation(fields: [storeId], references: [id])
  site                 Site?        @relation(fields: [siteId], references: [id])
  projectId            String?
  project              Project?     @relation(fields: [projectId], references: [id])
  creator              User         @relation("OrderCreator", fields: [createdBy], references: [id])

  @@unique([organizationId, orderNumber])
  @@index([organizationId, vendorPartyId])
  @@index([organizationId, materialId])
  @@index([status])
}

model Conversation {
  id             String    @id @default(uuid())
  organizationId String
  type           String    @default("DIRECT") // DIRECT, GROUP
  name           String?   // Name if GROUP
  description    String?   // Optional description if GROUP
  createdById    String    // Super Admin or user who initiated
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("ConversationCreator", fields: [createdById], references: [id])
  participants   ConversationParticipant[]
  messages       ChatMessage[]

  @@index([organizationId])
  @@index([type])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model ChatMessage {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  imageUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model TaskComment {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  userId         String
  content        String
  type           String   @default("COMMENT") // COMMENT, QUESTION, ASSISTANCE_REQUEST, PROGRESS_UPDATE
  photoUrl       String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([organizationId])
}

model DocumentFolder {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String
  name           String
  description    String?
  parentId       String?
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         DocumentFolder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders     DocumentFolder[]   @relation("FolderHierarchy")
  attachments    Attachment[]
  permissions    FolderPermission[]

  @@unique([projectId, parentId, name])
  @@index([organizationId, projectId])
}

model Attachment {
  id                  String    @id @default(uuid())
  organizationId      String
  entityType          String    // PAYMENT, BILL, PARTY, MATERIAL, STOCK_MOVEMENT, ATTENDANCE, TASK, PROJECT_DOCUMENT
  entityId            String
  fileId              String
  fileName            String
  fileSize            Int
  mimeType            String
  category            String    @default("GENERAL") // PHOTO, INVOICE, CHALLAN, DRAWING, SPECIFICATION, RECEIPT, GENERAL
  diskFileName        String
  projectId           String?
  folderId            String?
  taskId              String?
  stockMovementId     String?
  attendanceSessionId String?
  materialId          String?
  paymentId           String?
  isArchived          Boolean   @default(false)
  archivedAt          DateTime?
  archivedById        String?
  archiveReason       String?
  notes               String?
  uploadedById        String
  createdAt           DateTime  @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder              DocumentFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  task                Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  stockMovement       StockMovement?     @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)
  attendanceSession   AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)
  material            Material?          @relation(fields: [materialId], references: [id], onDelete: SetNull)
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  uploadedBy          User               @relation(fields: [uploadedById], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, projectId])
  @@index([folderId])
  @@index([taskId])
  @@index([stockMovementId])
  @@index([attendanceSessionId])
  @@index([materialId])
  @@index([paymentId])
}

model ProjectAssignment {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String
  userId         String
  role           String?   // e.g. "SITE_SUPERVISOR", "SITE_ENGINEER", "CONTRACTOR", etc.
  status         String    @default("ACTIVE") // ACTIVE, REVOKED, INACTIVE
  assignedById   String
  assignedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User         @relation("ProjectAssignmentAssigner", fields: [assignedById], references: [id])

  @@unique([projectId, userId])
  @@index([organizationId, projectId])
  @@index([userId, status])
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String    // TASK_REMINDER, LOW_STOCK, ORDER_APPROVAL, PAYMENT_APPROVAL, CHAT_MESSAGE, GENERAL
  title          String
  message        String
  severity       String    @default("INFO") // INFO, WARNING, CRITICAL
  entityType     String?   // TASK, MATERIAL, BILL, PAYMENT, etc.
  entityId       String?
  href           String?
  readAt         DateTime?
  deliveredAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([organizationId, entityType, entityId])
}

model FolderPermission {
  id             String    @id @default(uuid())
  organizationId String
  folderId       String
  userId         String?
  role           String?   // Optional role-based permission (e.g. "SITE_SUPERVISOR")
  canView        Boolean   @default(true)
  canUpload      Boolean   @default(false)
  canEdit        Boolean   @default(false)
  canDelete      Boolean   @default(false)
  canDownload    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder         DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, folderId])
  @@index([folderId, userId])
  @@index([folderId, role])
}

model MeasurementBookEntry {
  id              String    @id @default(uuid())
  organizationId  String
  projectId       String
  partyId         String
  itemDescription String
  unit            String    // SQM, CUM, RMT, NOS, TONNE
  count           Int       @default(1)
  length          Float     @default(1.0)
  breadth         Float?
  depth           Float?
  quantity        Float     @default(1.0)
  unitRate        Int       @default(0) // paise
  totalAmount     Int       @default(0) // paise
  status          String    @default("SUBMITTED") // DRAFT, SUBMITTED, VERIFIED, APPROVED, REJECTED, BILLED
  billId          String?
  notes           String?
  createdBy       String
  createdByName   String?
  approvedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  party           Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  bill            Bill?        @relation("MeasurementToBill", fields: [billId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([partyId])
  @@index([status])
  @@index([billId])
  @@index([createdAt])
}

model WorkforceHeadcount {
  id             String    @id @default(uuid())
  organizationId String
  siteId         String
  siteName       String
  date           String    // YYYY-MM-DD
  shift          String    @default("GENERAL") // GENERAL, DAY, NIGHT
  artisanCount   Int       @default(0)
  craftsmanCount Int       @default(0)
  laborerMale    Int       @default(0)
  laborerFemale  Int       @default(0)
  laborerTotal   Int       @default(0)
  grandTotal     Int       @default(0)
  contractorName String?
  notes          String?
  supervisorId   String
  supervisorName String
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([siteId])
  @@index([date])
  @@index([organizationId, siteId, date, shift])
}
