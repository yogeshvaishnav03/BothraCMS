datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  currency     String   @default("INR")
  timezone     String   @default("Asia/Kolkata")
  settingsJson String?
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users              User[]
  sites              Site[]
  projects           Project[]
  materials          Material[]
  materialCategories MaterialCategory[]
  parties            Party[]
  workforceMembers   WorkforceMember[]
  auditEvents        AuditEvent[]
  tasks              Task[]
  bills              Bill[]
  payments           Payment[]
  stores             Store[]
  stockMovements     StockMovement[]
  attendanceSessions AttendanceSession[]
  dailyReports       DailySiteReport[]
  purchaseOrders     PurchaseOrder[]
  conversations      Conversation[]
  attachments        Attachment[]
  documentFolders    DocumentFolder[]
  taskComments       TaskComment[]
  projectAssignments ProjectAssignment[]
  notifications      Notification[]
  folderPermissions  FolderPermission[]
  measurementBookEntries MeasurementBookEntry[]
  workforceHeadcounts     WorkforceHeadcount[]
  dailyWorkReports        DailyWorkReport[]
  staffAttendance         StaffAttendance[]
  budgetLines             ProjectBudgetLine[]
  milestones              ProjectMilestone[]
  materialRequests        MaterialRequest[]
  payrollProfiles         PayrollProfile[]
  payrollAdvances         PayrollAdvance[]
  payrollRuns             PayrollRun[]
  drawings                Drawing[]
  qualityInspections      QualityInspection[]
  siteIssues              SiteIssue[]
  equipment               Equipment[]
  salesUnits              SalesUnit[]
  salesLeads              SalesLead[]
  salesBookings           SalesBooking[]
  salesReceipts           SalesReceipt[]
}

model User {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  email          String
  passwordHash   String
  role           String    @default("SITE_SUPERVISOR") // SUPER_ADMIN, ORG_ADMIN, PROJECT_MANAGER, SITE_SUPERVISOR, ACCOUNTANT, STOREKEEPER, HR_VIEWER, AUDITOR
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE
  phone          String?   // mobile, used for WhatsApp / call buttons
  jobTitle       String?   // e.g. Site Engineer, Architect, Accounts Head
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization                Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  managedProjects             Project[]             @relation("ProjectManager")
  assignedTasks               Task[]                @relation("TaskAssignee")
  createdTasks                Task[]                @relation("TaskCreator")
  taskHistories               TaskStatusHistory[]
  createdReports              DailySiteReport[]
  createdMovements            StockMovement[]
  createdBills                Bill[]
  createdPayments             Payment[]
  createdAttendance           AttendanceSession[]   @relation("AttendanceCreator")
  correctedAttendance         AttendanceSession[]   @relation("AttendanceCorrector")
  createdOrders               PurchaseOrder[]       @relation("OrderCreator")
  createdConversations        Conversation[]        @relation("ConversationCreator")
  conversationParticipants    ConversationParticipant[]
  sentMessages                ChatMessage[]
  auditEvents                 AuditEvent[]
  completedTasks              Task[]                @relation("TaskCompleter")
  verifiedTasks               Task[]                @relation("TaskVerifier")
  taskComments                TaskComment[]
  uploadedAttachments         Attachment[]
  projectAssignments          ProjectAssignment[]
  assignedProjectAssignments  ProjectAssignment[]   @relation("ProjectAssignmentAssigner")
  notifications               Notification[]
  folderPermissions           FolderPermission[]
  workReports                 DailyWorkReport[]     @relation("WorkReportAuthor")
  reviewedWorkReports         DailyWorkReport[]     @relation("WorkReportReviewer")
  staffAttendance             StaffAttendance[]
  milestoneUpdates            ProjectMilestoneUpdate[]
  materialRequests            MaterialRequest[]     @relation("MaterialRequester")
  reviewedMaterialRequests    MaterialRequest[]     @relation("MaterialRequestReviewer")
  salesReceipts               SalesReceipt[]        @relation("SalesReceiptCreator")

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Site {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String
  address        String
  latitude       Float?
  longitude      Float?
  status         String   @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects           Project[]
  stores             Store[]
  workforceMembers   WorkforceMember[]
  attendanceSessions AttendanceSession[]
  purchaseOrders     PurchaseOrder[]
  workforceHeadcounts WorkforceHeadcount[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Project {
  id             String    @id @default(uuid())
  organizationId String
  siteId         String
  code           String
  name           String
  managerUserId  String?
  status         String    @default("IN_PROGRESS") // PLANNING, IN_PROGRESS, ON_HOLD, COMPLETED, ARCHIVED
  startDate      DateTime?
  endDate        DateTime?
  budgetAmount   Float     @default(0) // currency amount (e.g. INR rupees)
  notes          String?
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site               Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  manager            User?               @relation("ProjectManager", fields: [managerUserId], references: [id])
  tasks              Task[]
  dailyReports       DailySiteReport[]
  stockMovements     StockMovement[]
  bills              Bill[]
  payments           Payment[]
  attendanceSessions AttendanceSession[]
  purchaseOrders     PurchaseOrder[]
  attachments        Attachment[]
  documentFolders    DocumentFolder[]
  workReports        DailyWorkReport[]
  budgetLines        ProjectBudgetLine[]
  milestones         ProjectMilestone[]
  materialRequests   MaterialRequest[]
  drawings           Drawing[]
  qualityInspections QualityInspection[]
  siteIssues         SiteIssue[]
  salesUnits         SalesUnit[]
  assignments        ProjectAssignment[]
  measurementBookEntries MeasurementBookEntry[]

  @@unique([organizationId, code])
  @@index([organizationId, siteId])
}

model Task {
  id                  String    @id @default(uuid())
  organizationId      String
  projectId           String
  title               String
  description         String?
  priority            String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status              String    @default("TODO") // TODO, IN_PROGRESS, BLOCKED, COMPLETED, VERIFIED, ARCHIVED
  assigneeUserId      String?
  dueAt               DateTime?
  completedAt         DateTime?
  completedById       String?
  verifiedAt          DateTime?
  verifiedById        String?
  taskType            String?   @default("STANDARD") // STANDARD, PERSONAL, REQUEST_OWNER, REQUEST_MANAGER, REQUEST_ARCHITECT
  reminderAt          DateTime?
  reminderDeliveredAt DateTime?
  isArchived          Boolean   @default(false)
  archivedAt          DateTime?
  archivedById        String?
  archiveReason       String?
  createdBy           String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?               @relation("TaskAssignee", fields: [assigneeUserId], references: [id])
  creator        User                @relation("TaskCreator", fields: [createdBy], references: [id])
  completedBy    User?               @relation("TaskCompleter", fields: [completedById], references: [id])
  verifiedBy     User?               @relation("TaskVerifier", fields: [verifiedById], references: [id])
  statusHistory  TaskStatusHistory[]
  comments       TaskComment[]
  attachments    Attachment[]
  stockMovements StockMovement[]

  @@index([organizationId, projectId])
  @@index([status])
}

model TaskStatusHistory {
  id         String   @id @default(uuid())
  taskId     String
  oldStatus  String
  newStatus  String
  changedBy  String
  note       String?
  createdAt  DateTime @default(now())

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [changedBy], references: [id])

  @@index([taskId])
}

model DailySiteReport {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  reportDate     String   // YYYY-MM-DD
  progress       String
  blockers       String?
  safetyNotes    String?
  createdBy      String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator        User         @relation(fields: [createdBy], references: [id])

  @@index([organizationId, projectId, reportDate])
}

model MaterialCategory {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  materials      Material[]

  @@unique([organizationId, name])
}

model Material {
  id             String    @id @default(uuid())
  organizationId String
  categoryId     String?
  sku            String
  name           String
  unitCode       String   // BAG, KG, TONNE, LITRE, METER, PIECE, BOX
  minStockQty    Float    @default(0)
  reorderQty     Float    @default(0)
  active         Boolean  @default(true)
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       MaterialCategory? @relation(fields: [categoryId], references: [id])
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  billLines      BillLine[]
  purchaseOrders PurchaseOrder[]
  attachments    Attachment[]
  requestItems   MaterialRequestItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model Store {
  id             String    @id @default(uuid())
  organizationId String
  siteId         String
  name           String
  status         String    @default("ACTIVE") // ACTIVE, ARCHIVED
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId, siteId])
}

model StockBalance {
  id             String   @id @default(uuid())
  materialId     String
  storeId        String
  quantityOnHand Float    @default(0)
  updatedAt      DateTime @updatedAt

  material       Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([materialId, storeId])
  @@index([storeId])
}

model StockMovement {
  id             String    @id @default(uuid())
  organizationId String
  materialId     String
  storeId        String
  movementType   String    // RECEIPT, ISSUE, TRANSFER_IN, TRANSFER_OUT, ADJUSTMENT, OPENING
  quantityDelta  Float     // positive for in, negative for out
  unitCode       String
  unitRate       Float?    // rate per unit (paise/currency)
  movementAt     DateTime  @default(now())
  vendorPartyId  String?
  projectId      String?
  taskId         String?
  referenceDoc   String?   // Challan #, PO #, Transfer Voucher #
  reversalOfId   String?
  notes          String?
  isArchived     Boolean   @default(false)
  createdBy      String
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  material       Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vendor         Party?       @relation(fields: [vendorPartyId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])
  task           Task?        @relation(fields: [taskId], references: [id])
  creator        User         @relation(fields: [createdBy], references: [id])
  attachments    Attachment[]

  @@index([organizationId, materialId, storeId])
  @@index([movementAt])
}

model Party {
  id            String    @id @default(uuid())
  organizationId String
  partyType     String   // VENDOR, CONTRACTOR, BOTH
  name          String
  phone         String?
  email         String?
  address       String?
  taxIdentifier String?  // GSTIN / PAN
  active        Boolean  @default(true)
  isArchived    Boolean   @default(false)
  archivedAt    DateTime?
  archivedById  String?
  archiveReason String?
  notes         String?
  contractValue Float?   @default(0)
  // Business profile
  contactPerson String?
  whatsappNumber String?  // falls back to phone when empty
  city          String?
  category      String?  // trade or supply line, e.g. Cement, Steel, RCC work, Shuttering
  rating        Int?     // 1-5, internal vendor rating
  panNumber     String?
  // Bank details for payments. Full account numbers are only returned by
  // GET /api/parties/[id]/bank (finance:write, audited); lists show the last 4 digits.
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  bankBranch        String?
  upiId             String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  bills          Bill[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  measurementBookEntries MeasurementBookEntry[]

  @@index([organizationId, partyType])
}

model Bill {
  id             String    @id @default(uuid())
  organizationId String
  partyId        String
  projectId      String?
  billNumber     String
  billDate       DateTime
  dueDate        DateTime?
  totalAmount    Float     // minor units / currency, including GST
  gstRate        Float?    // % charged by the supplier; null for bills entered without GST
  taxableAmount  Float?    // paise before GST (sum of the lines)
  cgst           Float     @default(0) // paise
  sgst           Float     @default(0)
  igst           Float     @default(0) // supplier in another state
  itcEligible    Boolean   @default(true) // input tax credit can be claimed
  reverseCharge  Boolean   @default(false) // we pay the GST to the government, not the supplier
  costHead       String?   // MATERIAL, LABOUR, CONTRACTOR, EQUIPMENT, DESIGN, APPROVALS, OVERHEADS, OTHER (inferred when empty)
  status         String    @default("POSTED") // DRAFT, POSTED, VOIDED, ARCHIVED
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  notes          String?
  createdBy      String
  postedAt       DateTime? @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party          Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id])
  creator        User         @relation(fields: [createdBy], references: [id])
  lines          BillLine[]
  allocations    PaymentAllocation[]
  measurements   MeasurementBookEntry[] @relation("MeasurementToBill")

  @@unique([organizationId, partyId, billNumber])
  @@index([organizationId, partyId])
  @@index([status])
}

model BillLine {
  id          String   @id @default(uuid())
  billId      String
  description String
  materialId  String?
  quantity    Float?
  unitRate    Float?   // currency
  lineTotal   Float    // currency, before GST
  gstRate     Float?   // % on this line; null when the bill has no GST
  taxAmount   Float    @default(0) // GST on this line

  bill        Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  material    Material? @relation(fields: [materialId], references: [id])

  @@index([billId])
}

model Payment {
  id              String    @id @default(uuid())
  organizationId  String
  partyId         String?
  recipientType   String?   @default("VENDOR") // VENDOR, CONTRACTOR, EMPLOYEE
  recipientName   String?
  payingAccount   String?   // Account from which to pay (e.g., "HDFC Bank Operating A/C", "ICICI Bank", "Petty Cash")
  approvalQuery   String?   // Reason or query submitted to Super Admin for approval
  approvedBy      String?   // Super Admin who confirmed or rejected
  approvedAt      DateTime?
  rejectionReason String?   // Reason if rejected
  projectId       String?
  paymentDate     DateTime
  amount          Float     // minor units / currency
  currency        String    @default("INR")
  method          String    // BANK_TRANSFER, UPI, CASH, CHEQUE, NEFT_RTGS
  costHead        String?   // same heads as Bill.costHead (inferred when empty)
  referenceNumber String
  status          String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, POSTED, REJECTED, REVERSED
  idempotencyKey  String
  reversedAt      DateTime?
  reversalReason  String?
  isArchived      Boolean   @default(false)
  archivedAt      DateTime?
  archivedById    String?
  archiveReason   String?
  notes           String?
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  party           Party?       @relation(fields: [partyId], references: [id], onDelete: Cascade)
  project         Project?     @relation(fields: [projectId], references: [id])
  creator         User         @relation(fields: [createdBy], references: [id])
  allocations     PaymentAllocation[]
  attachments     Attachment[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, partyId])
  @@index([paymentDate])
}

model PaymentAllocation {
  id         String    @id @default(uuid())
  paymentId  String
  billId     String
  amount     Float     // minor units / currency
  reversedAt DateTime?
  createdAt  DateTime  @default(now())

  payment    Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bill       Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([billId])
}

model WorkforceMember {
  id             String    @id @default(uuid())
  organizationId String
  employeeCode   String
  name           String
  workerType     String   // MASON, CARPENTER, ELECTRICIAN, PLUMBER, HELPER, FOREMAN, SITE_ENGINEER
  phone          String?
  defaultSiteId  String?
  dailyWageRate  Float?   // paise per day
  pfApplicable   Boolean  @default(false)
  esiApplicable  Boolean  @default(false)
  uan            String?
  esicNumber     String?
  bankAccount    String?
  ifsc           String?
  active         Boolean  @default(true)
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultSite        Site?               @relation(fields: [defaultSiteId], references: [id])
  attendanceSessions AttendanceSession[]

  @@unique([organizationId, employeeCode])
  @@index([organizationId])
}

model AttendanceSession {
  id                String    @id @default(uuid())
  organizationId    String
  workforceMemberId String
  siteId            String
  projectId         String?
  workDate          String    // YYYY-MM-DD
  checkInAt         DateTime
  checkInLat        Float?
  checkInLng        Float?
  checkInAccuracyM  Float?
  checkOutAt        DateTime?
  checkOutLat       Float?
  checkOutLng       Float?
  checkOutAccuracyM Float?
  status            String    @default("PRESENT") // PRESENT, HALF_DAY, OVERTIME, CORRECTED, ABSENT
  notes             String?
  correctedBy       String?
  correctionReason  String?
  isArchived        Boolean   @default(false)
  archivedAt        DateTime?
  archivedById      String?
  archiveReason     String?
  createdBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workforceMember   WorkforceMember @relation(fields: [workforceMemberId], references: [id], onDelete: Cascade)
  site              Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  project           Project?        @relation(fields: [projectId], references: [id])
  creator           User            @relation("AttendanceCreator", fields: [createdBy], references: [id])
  corrector         User?           @relation("AttendanceCorrector", fields: [correctedBy], references: [id])
  attachments       Attachment[]

  @@unique([organizationId, workforceMemberId, siteId, workDate])
  @@index([organizationId, siteId, workDate])
}

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  actorUserId    String
  action         String   // PAYMENT_POSTED, PAYMENT_REVERSED, STOCK_ADJUSTMENT, ATTENDANCE_CORRECTED, ROLE_CHANGED, etc.
  entityType     String
  entityId       String
  beforeJson     String?
  afterJson      String?
  reason         String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User         @relation(fields: [actorUserId], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([createdAt])
}

model RateLimitRecord {
  key       String   @id
  points    Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model IdempotencyRecord {
  id               String   @id @default(uuid())
  organizationId   String
  key              String
  operation        String
  responseCode     Int
  responseBodyJson String
  createdAt        DateTime @default(now())

  @@unique([organizationId, key])
  @@index([organizationId, key])
}

model PurchaseOrder {
  id                   String    @id @default(uuid())
  organizationId       String
  orderNumber          String
  materialId           String
  vendorPartyId        String
  storeId              String?
  siteId               String?
  quantity             Float
  unitCode             String
  unitRate             Float?
  totalAmount          Float?
  status               String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, PLACED, CONFIRMED, DELIVERED, CANCELLED
  approvalQuery        String?   // Query or justification submitted to Super Admin for approval
  approvedBy           String?   // User / Super Admin who confirmed or rejected
  approvedAt           DateTime?
  rejectionReason      String?   // Reason provided if rejected
  expectedDeliveryDate DateTime?
  notes                String?
  notificationMethod   String?   @default("WHATSAPP_AND_EMAIL")
  notificationSent     Boolean   @default(false)
  notificationSentAt   DateTime?
  createdBy            String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  material             Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  vendor               Party        @relation(fields: [vendorPartyId], references: [id], onDelete: Cascade)
  store                Store?       @relation(fields: [storeId], references: [id])
  site                 Site?        @relation(fields: [siteId], references: [id])
  projectId            String?
  project              Project?     @relation(fields: [projectId], references: [id])
  creator              User         @relation("OrderCreator", fields: [createdBy], references: [id])
  requestItems         MaterialRequestItem[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, vendorPartyId])
  @@index([organizationId, materialId])
  @@index([status])
}

model Conversation {
  id             String    @id @default(uuid())
  organizationId String
  type           String    @default("DIRECT") // DIRECT, GROUP
  name           String?   // Name if GROUP
  description    String?   // Optional description if GROUP
  createdById    String    // Super Admin or user who initiated
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User         @relation("ConversationCreator", fields: [createdById], references: [id])
  participants   ConversationParticipant[]
  messages       ChatMessage[]

  @@index([organizationId])
  @@index([type])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model ChatMessage {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  imageUrl       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model TaskComment {
  id             String   @id @default(uuid())
  organizationId String
  taskId         String
  userId         String
  content        String
  type           String   @default("COMMENT") // COMMENT, QUESTION, ASSISTANCE_REQUEST, PROGRESS_UPDATE
  photoUrl       String?
  photoUrls      String?  // JSON array of /api/uploads/... urls attached to a progress update
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([organizationId])
}

model DocumentFolder {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String
  name           String
  description    String?
  parentId       String?
  isArchived     Boolean   @default(false)
  archivedAt     DateTime?
  archivedById   String?
  archiveReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent         DocumentFolder?    @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  subfolders     DocumentFolder[]   @relation("FolderHierarchy")
  attachments    Attachment[]
  permissions    FolderPermission[]

  @@unique([projectId, parentId, name])
  @@index([organizationId, projectId])
}

model Attachment {
  id                  String    @id @default(uuid())
  organizationId      String
  entityType          String    // PAYMENT, BILL, PARTY, MATERIAL, STOCK_MOVEMENT, ATTENDANCE, TASK, PROJECT_DOCUMENT
  entityId            String
  fileId              String
  fileName            String
  fileSize            Int
  mimeType            String
  category            String    @default("GENERAL") // PHOTO, INVOICE, CHALLAN, DRAWING, SPECIFICATION, RECEIPT, GENERAL
  diskFileName        String
  projectId           String?
  folderId            String?
  taskId              String?
  stockMovementId     String?
  attendanceSessionId String?
  materialId          String?
  paymentId           String?
  isArchived          Boolean   @default(false)
  archivedAt          DateTime?
  archivedById        String?
  archiveReason       String?
  notes               String?
  uploadedById        String
  createdAt           DateTime  @default(now())

  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  folder              DocumentFolder?    @relation(fields: [folderId], references: [id], onDelete: SetNull)
  task                Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  stockMovement       StockMovement?     @relation(fields: [stockMovementId], references: [id], onDelete: SetNull)
  attendanceSession   AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)
  material            Material?          @relation(fields: [materialId], references: [id], onDelete: SetNull)
  payment             Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  uploadedBy          User               @relation(fields: [uploadedById], references: [id])

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, projectId])
  @@index([folderId])
  @@index([taskId])
  @@index([stockMovementId])
  @@index([attendanceSessionId])
  @@index([materialId])
  @@index([paymentId])
}

model ProjectAssignment {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String
  userId         String
  role           String?   // e.g. "SITE_SUPERVISOR", "SITE_ENGINEER", "CONTRACTOR", etc.
  status         String    @default("ACTIVE") // ACTIVE, REVOKED, INACTIVE
  assignedById   String
  assignedAt     DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedBy     User         @relation("ProjectAssignmentAssigner", fields: [assignedById], references: [id])

  @@unique([projectId, userId])
  @@index([organizationId, projectId])
  @@index([userId, status])
}

model Notification {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  type           String    // TASK_REMINDER, LOW_STOCK, ORDER_APPROVAL, PAYMENT_APPROVAL, CHAT_MESSAGE, GENERAL
  title          String
  message        String
  severity       String    @default("INFO") // INFO, WARNING, CRITICAL
  entityType     String?   // TASK, MATERIAL, BILL, PAYMENT, etc.
  entityId       String?
  href           String?
  readAt         DateTime?
  deliveredAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt])
  @@index([organizationId, entityType, entityId])
}

model FolderPermission {
  id             String    @id @default(uuid())
  organizationId String
  folderId       String
  userId         String?
  role           String?   // Optional role-based permission (e.g. "SITE_SUPERVISOR")
  canView        Boolean   @default(true)
  canUpload      Boolean   @default(false)
  canEdit        Boolean   @default(false)
  canDelete      Boolean   @default(false)
  canDownload    Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  folder         DocumentFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, folderId])
  @@index([folderId, userId])
  @@index([folderId, role])
}

model MeasurementBookEntry {
  id              String    @id @default(uuid())
  organizationId  String
  projectId       String
  partyId         String
  itemDescription String
  unit            String    // SQM, CUM, RMT, NOS, TONNE
  count           Int       @default(1)
  length          Float     @default(1.0)
  breadth         Float?
  depth           Float?
  quantity        Float     @default(1.0)
  unitRate        Int       @default(0) // paise
  totalAmount     Int       @default(0) // paise
  status          String    @default("SUBMITTED") // DRAFT, SUBMITTED, VERIFIED, APPROVED, REJECTED, BILLED
  billId          String?
  notes           String?
  createdBy       String
  createdByName   String?
  approvedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  party           Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  bill            Bill?        @relation("MeasurementToBill", fields: [billId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([partyId])
  @@index([status])
  @@index([billId])
  @@index([createdAt])
}

model WorkforceHeadcount {
  id             String    @id @default(uuid())
  organizationId String
  siteId         String
  siteName       String
  date           String    // YYYY-MM-DD
  shift          String    @default("GENERAL") // GENERAL, DAY, NIGHT
  artisanCount   Int       @default(0)
  craftsmanCount Int       @default(0)
  laborerMale    Int       @default(0)
  laborerFemale  Int       @default(0)
  laborerTotal   Int       @default(0)
  grandTotal     Int       @default(0)
  contractorName String?
  notes          String?
  supervisorId   String
  supervisorName String
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  site           Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([siteId])
  @@index([date])
  @@index([organizationId, siteId, date, shift])
}

// What an office or site employee did during one day, filed by the employee and reviewed by an admin.
model DailyWorkReport {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  reportDate     String    // YYYY-MM-DD (IST)
  summary        String
  hoursWorked    Float?
  projectId      String?
  blockers       String?
  tomorrowPlan   String?
  photoUrls      String?   // JSON array of /api/uploads/... urls
  status         String    @default("SUBMITTED") // SUBMITTED, REVIEWED, NEEDS_INFO
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("WorkReportAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy     User?        @relation("WorkReportReviewer", fields: [reviewedById], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId, reportDate])
  @@index([organizationId, reportDate])
}

// Check-in / check-out for staff who log in to the CMS (engineers, accounts, office).
// Labour on site keeps using AttendanceSession through WorkforceMember.
model StaffAttendance {
  id             String    @id @default(uuid())
  organizationId String
  userId         String
  workDate       String    // YYYY-MM-DD (IST)
  checkInAt      DateTime
  checkInLat     Float?
  checkInLng     Float?
  checkInNote    String?
  checkOutAt     DateTime?
  checkOutLat    Float?
  checkOutLng    Float?
  status         String    @default("PRESENT") // PRESENT, HALF_DAY, LEAVE
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, workDate])
  @@index([organizationId, workDate])
}

// Budget for one cost head of a project (amounts in paise).
model ProjectBudgetLine {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  costHead       String   // MATERIAL, LABOUR, CONTRACTOR, EQUIPMENT, DESIGN, APPROVALS, OVERHEADS, OTHER
  budgetAmount   Int      @default(0) // paise
  notes          String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, costHead])
  @@index([organizationId])
}

// A stage of construction (foundation, slab, brickwork...) with planned dates and % done.
model ProjectMilestone {
  id              String    @id @default(uuid())
  organizationId  String
  projectId       String
  name            String
  description     String?
  sortOrder       Int       @default(0)
  weight          Float     @default(1) // share of overall project progress
  plannedStart    DateTime?
  plannedEnd      DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  progressPercent Int       @default(0)
  status          String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, ON_HOLD, COMPLETED
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  updates         ProjectMilestoneUpdate[]

  @@index([organizationId, projectId])
}

// Every progress change on a milestone, with a note and site photos.
model ProjectMilestoneUpdate {
  id           String   @id @default(uuid())
  milestoneId  String
  userId       String
  progressFrom Int
  progressTo   Int
  statusTo     String?
  note         String?
  photoUrls    String?  // JSON array of /api/uploads/... urls
  createdAt    DateTime @default(now())

  milestone    ProjectMilestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id])

  @@index([milestoneId])
}

// A request from site for material, approved by the office and turned into purchase orders.
model MaterialRequest {
  id              String    @id @default(uuid())
  organizationId  String
  requestNumber   String
  projectId       String
  requestedById   String
  neededBy        DateTime?
  priority        String    @default("NORMAL") // NORMAL, URGENT
  status          String    @default("PENDING") // PENDING, APPROVED, PARTLY_ORDERED, ORDERED, REJECTED, CANCELLED
  notes           String?
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy     User         @relation("MaterialRequester", fields: [requestedById], references: [id])
  reviewedBy      User?        @relation("MaterialRequestReviewer", fields: [reviewedById], references: [id])
  items           MaterialRequestItem[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
}

model MaterialRequestItem {
  id              String   @id @default(uuid())
  requestId       String
  materialId      String?
  description     String   // material name, or free text when it is not in the catalogue
  quantity        Float
  unitCode        String
  approvedQty     Float?
  purchaseOrderId String?

  request         MaterialRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  material        Material?       @relation(fields: [materialId], references: [id])
  purchaseOrder   PurchaseOrder?  @relation(fields: [purchaseOrderId], references: [id])

  @@index([requestId])
}

// ── Phase 5: payroll ────────────────────────────────────────────────────────
// Amounts in paise. Person is either a site worker (WorkforceMember) or a staff login (User).

model PayrollProfile {
  id             String   @id @default(uuid())
  organizationId String
  userId         String   // staff member with a login
  monthlySalary  Int      // paise
  bankAccount    String?  // shown masked
  ifsc           String?
  pfApplicable   Boolean  @default(false) // EPF: 12% of basic up to the wage ceiling
  esiApplicable  Boolean  @default(false) // ESI: 0.75% while gross is within the limit
  uan            String?  // PF Universal Account Number
  esicNumber     String?
  taxRegime      String   @default("NEW") // NEW or OLD income-tax regime, for TDS on salary
  taxDeclared    Int      @default(0) // paise a year: old-regime deductions claimed (80C beyond PF, 80D, HRA...)
  pan            String?  // for the TDS return; without it TDS is 20% (section 206AA)
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model PayrollAdvance {
  id             String    @id @default(uuid())
  organizationId String
  personType     String    // LABOUR, STAFF
  personId       String    // WorkforceMember.id or User.id
  personName     String
  amount         Int       // paise
  givenOn        String    // YYYY-MM-DD
  note           String?
  recoveredRunId String?   // payroll run that deducted it
  createdBy      String
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, personType, personId])
}

model PayrollRun {
  id             String    @id @default(uuid())
  organizationId String
  month          String    // YYYY-MM
  status         String    @default("DRAFT") // DRAFT, APPROVED, PAID
  totalGross     Int       @default(0)
  totalDeductions Int      @default(0)
  totalNet       Int       @default(0)
  createdBy      String
  approvedBy     String?
  approvedAt     DateTime?
  paidAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines          PayrollLine[]

  @@unique([organizationId, month])
}

model PayrollLine {
  id              String   @id @default(uuid())
  runId           String
  personType      String   // LABOUR, STAFF
  personId        String
  personName      String
  roleLabel       String?  // MASON, Site Engineer...
  projectId       String?  // where most days were worked (labour cost goes here)
  daysPresent     Float    @default(0)
  halfDays        Int      @default(0)
  leaveDays       Float    @default(0)
  payableDays     Float    @default(0)
  overtimeHours   Float    @default(0)
  rate            Int      // paise: daily wage (labour) or monthly salary (staff)
  basePay         Int      @default(0)
  overtimePay     Int      @default(0)
  bonus           Int      @default(0)
  advanceDeduction Int     @default(0)
  otherDeduction  Int      @default(0)
  pfEmployee      Int      @default(0) // statutory deductions (paise)
  esiEmployee     Int      @default(0)
  professionalTax Int      @default(0)
  tds             Int      @default(0) // worked out from the tax regime, or typed in
  tdsManual       Boolean  @default(false) // true when someone typed the TDS in
  pfEmployer      Int      @default(0) // employer's share, a cost on top of gross
  esiEmployer     Int      @default(0)
  gross           Int      @default(0)
  net             Int      @default(0)
  note            String?
  paymentId       String?

  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ── Phase 5: drawings register ──────────────────────────────────────────────

model Drawing {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  number         String   // e.g. STR-GF-101
  title          String
  discipline     String   @default("ARCHITECTURAL") // ARCHITECTURAL, STRUCTURAL, ELECTRICAL, PLUMBING, HVAC, LANDSCAPE, OTHER
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisions      DrawingRevision[]

  @@unique([projectId, number])
  @@index([organizationId, projectId])
}

model DrawingRevision {
  id          String    @id @default(uuid())
  drawingId   String
  revision    String    // R0, R1...
  status      String    @default("FOR_APPROVAL") // FOR_APPROVAL, APPROVED, GFC, SUPERSEDED, REJECTED
  fileUrl     String?
  fileName    String?
  notes       String?
  uploadedBy  String
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  drawing     Drawing   @relation(fields: [drawingId], references: [id], onDelete: Cascade)

  @@unique([drawingId, revision])
}

// ── Phase 5: quality and safety ─────────────────────────────────────────────

model QualityInspection {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  milestoneId    String?
  template       String   // key of a built-in checklist, or CUSTOM
  title          String
  location       String?  // e.g. "3rd floor slab, grid A-C"
  itemsJson      String   // [{label, result: PASS|FAIL|NA, note}]
  result         String   // PASSED, FAILED
  photoUrls      String?  // JSON array
  inspectedBy    String
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId, projectId])
}

model SiteIssue {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String
  issueNumber    String
  kind           String    // NCR (quality defect), SAFETY_INCIDENT, NEAR_MISS, UNSAFE_ACT, OBSERVATION
  severity       String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  title          String
  description    String?
  location       String?
  photoUrls      String?
  inspectionId   String?
  injuredCount   Int       @default(0)
  assignedTo     String?
  dueDate        DateTime?
  status         String    @default("OPEN") // OPEN, RESOLVED, CLOSED
  resolution     String?
  resolutionPhotoUrls String?
  resolvedBy     String?
  resolvedAt     DateTime?
  reportedBy     String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([organizationId, issueNumber])
  @@index([organizationId, projectId, status])
}

// ── Phase 5: equipment ──────────────────────────────────────────────────────

model Equipment {
  id               String   @id @default(uuid())
  organizationId   String
  code             String
  name             String   // e.g. JCB 3DX Backhoe
  category         String   @default("EARTHMOVING") // EARTHMOVING, LIFTING, CONCRETE, SHUTTERING, POWER, VEHICLE, TOOLS, OTHER
  ownership        String   @default("OWNED") // OWNED, HIRED
  vendorPartyId    String?  // hire company
  hireRate         Int?     // paise
  hireRateUnit     String?  // HOUR, DAY, MONTH
  currentProjectId String?
  status           String   @default("AVAILABLE") // AVAILABLE, IN_USE, UNDER_REPAIR, RETURNED
  nextServiceDue   String?  // YYYY-MM-DD
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  logs             EquipmentLog[]

  @@unique([organizationId, code])
}

model EquipmentLog {
  id           String   @id @default(uuid())
  equipmentId  String
  projectId    String?
  logDate      String   // YYYY-MM-DD
  kind         String   @default("USAGE") // USAGE, FUEL, MAINTENANCE, BREAKDOWN, MOVE
  hours        Float?
  fuelLitres   Float?
  cost         Int      @default(0) // paise: fuel, repair, or hire for this entry
  operator     String?
  note         String?
  createdBy    String
  createdAt    DateTime @default(now())

  equipment    Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, logDate])
}

// ── Phase 5: sales ──────────────────────────────────────────────────────────

model SalesUnit {
  id             String   @id @default(uuid())
  organizationId String
  projectId      String
  unitNumber     String   // e.g. A-302
  unitType       String   // 2BHK, 3BHK, SHOP, PLOT, VILLA
  floor          String?
  areaSqft       Float?
  price          Int      // paise, list price
  status         String   @default("AVAILABLE") // AVAILABLE, HOLD, BOOKED, SOLD
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  bookings       SalesBooking[]

  @@unique([projectId, unitNumber])
}

model SalesLead {
  id             String    @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  phone          String
  email          String?
  source         String    @default("WALK_IN") // WALK_IN, REFERRAL, WEBSITE, PORTAL, NEWSPAPER, SOCIAL, BROKER, OTHER
  interest       String?   // e.g. 3BHK east facing
  budget         Int?      // paise
  stage          String    @default("NEW") // NEW, CONTACTED, SITE_VISIT, NEGOTIATION, BOOKED, LOST
  nextFollowUp   String?   // YYYY-MM-DD
  lostReason     String?
  assignedTo     String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities     SalesLeadActivity[]

  @@index([organizationId, stage])
}

model SalesLeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  kind      String   // CALL, WHATSAPP, SITE_VISIT, MEETING, NOTE, STAGE
  note      String
  createdBy String
  createdAt DateTime @default(now())

  lead      SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model SalesBooking {
  id              String   @id @default(uuid())
  organizationId  String
  unitId          String
  leadId          String?
  bookingNumber   String
  customerName    String
  customerPhone   String
  customerEmail   String?
  bookingDate     String   // YYYY-MM-DD
  agreementValue  Int      // paise, before GST
  gstRate         Float    @default(0) // % on each instalment, e.g. 5 for residential, 12 for shops
  portalToken     String?  @unique // secret link for the buyer's portal; reset to revoke
  status          String   @default("ACTIVE") // ACTIVE, CANCELLED
  createdBy       String
  createdAt       DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit            SalesUnit    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  installments    SalesInstallment[]
  receiptRows     SalesReceipt[]

  @@unique([organizationId, bookingNumber])
}

model SalesInstallment {
  id             String    @id @default(uuid())
  bookingId      String
  sortOrder      Int
  label          String    // Booking amount, On plinth, On 3rd slab...
  percent        Float?
  amount         Int       // paise, before GST
  gstAmount      Int       @default(0) // paise; the buyer pays amount + gstAmount
  dueDate        String?   // YYYY-MM-DD; null until the linked stage is reached
  milestoneId    String?   // stage that raises this demand; matched by name when empty
  demandRaisedAt DateTime?
  demandAuto     Boolean   @default(false) // raised by the stage reaching 100%
  receivedAmount Int       @default(0) // paise, including GST
  lastReceivedAt DateTime?
  receipts       String?   // legacy JSON [{amount, date, mode, reference, by}]; SalesReceipt rows from Phase 6

  booking        SalesBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  receiptRows    SalesReceipt[]

  @@index([bookingId])
}

// Money received from a buyer. Shows in the Day Book as money in and is
// exported to Tally as a sales invoice plus a receipt.
model SalesReceipt {
  id             String    @id @default(uuid())
  organizationId String
  bookingId      String
  installmentId  String
  receiptNumber  String    // RC-YYMM-NNN
  date           String    // YYYY-MM-DD
  amount         Int       // paise, including GST
  taxableAmount  Int       // paise
  gstAmount      Int       // paise
  mode           String    // NEFT, RTGS, UPI, CHEQUE, CASH, HOME_LOAN
  reference      String?
  cancelledAt    DateTime? // e.g. a bounced cheque; the amount goes back on the instalment
  cancelledBy    String?
  cancelReason   String?
  createdBy      String
  createdAt      DateTime  @default(now())

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User             @relation("SalesReceiptCreator", fields: [createdBy], references: [id])
  booking        SalesBooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  installment    SalesInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, date])
}

/// A request saved on a phone with no signal carries an id. The first time it
/// arrives its reply is kept here, so if the phone sends it again (the signal
/// dropped before the reply got back) the same reply is returned and nothing
/// is created twice.
model OfflineSend {
  ref            String   @id
  organizationId String
  userId         String
  route          String
  status         Int      @default(0) // 0 while it is being handled, then the HTTP status
  response       String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}
